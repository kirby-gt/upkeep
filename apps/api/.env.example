# Copy this file to .env in this same folder (apps/api/.env) and fill it in.

# Matches the credentials in docker-compose.yml at the repo root.
DATABASE_URL=postgresql://upkeep:upkeep_dev_password@localhost:5433/upkeep

# Any long random string — used to sign nothing yet in Slice 0, but the
# session layer is wired to read it now so later slices don't need a
# migration of their own. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

PORT=8787
